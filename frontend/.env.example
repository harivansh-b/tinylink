# ─── Clerk Authentication ───────────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# ─── Backend API Settings ────────────────────────────────────
# VITE_API_URL  : Base URL of your backend (NO trailing slash, NO /graphql suffix)
#                 Example: https://tinylink-57eg.onrender.com
VITE_API_URL=http://localhost:8000

# VITE_GRAPHQL_URL : Full URL to the GraphQL endpoint (= VITE_API_URL + /graphql)
#                    Example: https://tinylink-57eg.onrender.com/graphql
VITE_GRAPHQL_URL=http://localhost:8000/graphql

# VITE_SHORT_URL_BASE : Base for redirect short links
#                       Example: https://tinylink-57eg.onrender.com
VITE_SHORT_URL_BASE=http://localhost:8000

# ─── Razorpay (optional — only needed for payments) ─────────
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
